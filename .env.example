# AL Muraqib site — optional build-time configuration
# Copy to .env.local for local use; set in CI for production builds.

# GitHub Pages base path (only for the static export, e.g. /al_muraqib_web)
#NEXT_PUBLIC_BASE=
# Set to 1 to produce the static export (out/)
#NEXT_PUBLIC_STATIC_EXPORT=
# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX — leaves analytics off when unset
#NEXT_PUBLIC_GA_ID=
# Google Search Console HTML-tag verification value (site ownership)
#NEXT_PUBLIC_GSC_SITE_VERIFICATION=
# tawk.to live chat (components read these; empty = chat hidden)
#NEXT_PUBLIC_TAWK_PROPERTY_ID=
#NEXT_PUBLIC_TAWK_WIDGET_ID=
